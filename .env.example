# Copy to .env.local and fill in your own values.

# Supabase — Project Settings → Data API / API Keys
# The anon key is safe to expose to the browser; row level security is what
# actually protects the data (see supabase/schema.sql).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google AI Studio — https://aistudio.google.com/apikey
# Server-side only. Used by the task breakdown endpoint.
GOOGLE_AI_API_KEY=your-google-ai-api-key
